# Frontend settings. Copy to frontend/.env and edit. Vite only exposes VITE_* variables to the browser,
# so never put secrets here (the LLM key belongs in backend/.env).

# Where the dashboard calls the API. Leave empty to use the same origin:
#   npm run dev -> /api is proxied to VITE_API_PROXY_TARGET
#   npm run build + FastAPI serving dist -> same server
# Set a full URL (e.g. https://api.example.com) only if the API is hosted elsewhere; add this site's origin to
# CORS_ORIGINS in backend/.env when you do.
VITE_API_BASE_URL=

# Supabase project, for browser-side use (publishable key only; never the secret/service key).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Dev server only (npm run dev)
VITE_DEV_PORT=5173
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
