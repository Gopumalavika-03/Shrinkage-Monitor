# Backend settings. Copy to backend/.env and edit. backend/.env is git-ignored; never commit real keys.
# Every value has a default, so the backend also runs with no .env at all.

# --- API server (python -m app) ---
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false
# Browser origins allowed to call the API (comma-separated). Add yours if the frontend runs elsewhere.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Pipeline ---
# Where runs are written, one folder per size. Relative paths are relative to backend/.
OUTPUT_DIR=output

# --- Database (optional) ---
# Empty = the API reads the local SQLite file of each run. Set it to use Postgres / Supabase:
#   Supabase dashboard -> Connect -> "Session pooler" URI (works on IPv4 networks), password filled in:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Then load a run with `python -m app.db --size full`; pipeline runs from the dashboard load automatically.
DATABASE_URL=
# Each size goes in its own schema (<prefix>_small, <prefix>_full), outside `public`, so Supabase's REST API doesn't expose it.
DB_SCHEMA_PREFIX=shrinkage
# Supabase project (public values, safe to share). The bulk load needs DATABASE_URL above, not these.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# --- Optional LLM alert summaries (Explain button, --llm) ---
# Just set the key and model. The provider is detected from the key:
#   sk-...  OpenAI    gsk_...  Groq    AIza...  Gemini    sk-ant-...  Anthropic
# LLM_BASE_URL is only needed for anything else (e.g. Ollama: http://localhost:11434/v1). Leave it blank otherwise.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
